# Shell scripts must stay LF: they run on Linux/macOS (Kylin included). Without
# this, a Windows checkout with core.autocrlf=true rewrites them to CRLF and any
# copy of the working tree breaks on Linux ("bad interpreter: ^M").
*.sh text eol=lf

# Protocol and skill documents are text; keep them diffable.
*.md text
*.yml text
*.yaml text